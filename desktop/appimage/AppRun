#!/bin/sh
# ParrotMetric as an AppImage: the Debian package's launcher (deb/parrotmetric)
# on the Java runtime it carries, with everything found inside the image.
here="$(dirname "$(readlink -f "$0")")"
exec "$here/usr/lib/parrotmetric/jre/bin/java" \
    -Djava.library.path="$here/usr/lib/parrotmetric/native" \
    --enable-native-access=ALL-UNNAMED \
    -cp "$here/usr/lib/parrotmetric/lib/*" \
    com.rm.parrotmetric.desktop.MainKt "$@"
